{
  "name": "@cipherscan/zcash-decoder",
  "version": "1.0.7",
  "description": "Client-side decoder for Zcash shielded transactions and memos",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "wasm",
    "examples",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build:wasm && npm test",
    "test": "npm run build && npm run test:types && node --test test/*.test.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:browser": "npm run build && node test/browser.mjs",
    "test:types": "tsc --noEmit --ignoreConfig --lib es2022 --types node --strict --module nodenext --target es2022 test/types.mts"
  },
  "keywords": [
    "zcash",
    "wasm",
    "privacy",
    "blockchain",
    "shielded",
    "orchard",
    "sapling",
    "memo",
    "decryption",
    "viewing-key"
  ],
  "author": "CipherScan",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kenbak/zecblock.git",
    "directory": "packages/zcash-decoder"
  },
  "bugs": {
    "url": "https://github.com/Kenbak/zecblock/issues"
  },
  "homepage": "https://github.com/Kenbak/zecblock/tree/main/packages/zcash-decoder#readme",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "playwright": "1.65.0"
  },
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
