# Runtime
NODE_ENV=production
PORT=3001
NETWORK=mainnet

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=zcash_explorer_mainnet
DB_USER=zcash_user
DB_PASSWORD=replace_me

# Optional read-only hot standby. It must be a different PostgreSQL server and
# SELECT pg_is_in_recovery() must return true. Never point this at the primary.
# REPLICA_DATABASE_URL=postgres://cipherscan_api:replace_me@standby:5432/zcash_explorer_mainnet

# Zebra JSON-RPC and indexer stream
ZEBRA_RPC_URL=http://127.0.0.1:8232
ZEBRA_RPC_COOKIE_FILE=/root/.cache/zebra/.cookie
ZEBRA_GRPC_URL=127.0.0.1:8230

# Browser origins: CipherScan plus https://zecblock.com and https://www.zecblock.com
# are built into both HTTP CORS and WebSocket allowlists. No env change is needed
# for the rebrand. CORS_ORIGINS only adds extra HTTP origins, not WebSocket access.
# CORS_ORIGINS=https://additional-controlled-origin.example

# API protection and upstream integrations
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
SERVICE_API_KEYS=replace_me
NEAR_INTENTS_API_KEY=replace_me

# Shared list-response cache. Production Redis must remain private.
API_LIST_CACHE_ENABLED=1
API_CACHE_NAMESPACE=mainnet
API_LIST_CACHE_MAX_ENTRIES=1000
API_LIST_CACHE_REDIS_TIMEOUT_MS=50

# Stable API v1 dark launch. Disabled is an indistinguishable 404.
API_V1_ENABLED=0
API_V1_LAUNCHED=0
API_V1_PREVIEW_KEY=
V1_INTERNAL_API_BASE_URL=http://127.0.0.1:3001
V1_INTERNAL_SERVICE_KEY=
V1_INTERNAL_TIMEOUT_MS=8000
V1_INTERNAL_MAX_RESPONSE_BYTES=52428800
V1_SCAN_ORCHARD_MAX_RANGE=50000
V1_SCAN_ORCHARD_RATE_LIMIT_MAX=5
V1_SCAN_ORCHARD_RATE_LIMIT_WINDOW_MS=60000
V1_SCAN_LIGHTWALLETD_MAX_RANGE=10000
V1_SCAN_LIGHTWALLETD_RATE_LIMIT_MAX=3
V1_SCAN_LIGHTWALLETD_RATE_LIMIT_WINDOW_MS=60000

# Optional operations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Ask analytics client. Keep disabled until the private worker and
# actual replica role pass server/deploy/ask-analytics/README.md gates.
# The reader DSN belongs ONLY in the worker environment, never this API env.
ASK_ANALYTICS_ENABLED=false
ASK_ANALYTICS_SERVICE_URL=http://127.0.0.1:3015/
ASK_ANALYTICS_SERVICE_KEY=

# IndexNow discovery hints (mainnet only; see indexnow.js). Set on exactly one
# active API instance, with the same private key as the frontend's
# INDEXNOW_KEY (served at https://zecblock.com/<key>.txt). Requires NETWORK=mainnet.
INDEXNOW_KEY=
INDEXNOW_HOST=zecblock.com
