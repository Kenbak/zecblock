# CipherScan Data Bot — Environment Configuration
# Copy to /opt/cipherscan/.env.bot on production

# Database (same as the API)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zcash_explorer_mainnet
DB_USER=zcash_user
DB_PASSWORD=

# X (Twitter) API — OAuth2 User Context
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Bot behavior
BOT_DRY_RUN=1
BOT_DIGEST_HOUR=8

# Animated GIFs (replays from 21:00 UTC, landing GIFs for swaps and flows, the weekly heatmap). Need ffmpeg on the host.
# Optional: read history from another API base (default https://api.zecblock.com)
# BOT_API_BASE=

# Telegram alert when the X API account is out of credits (same variables as the signal alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
