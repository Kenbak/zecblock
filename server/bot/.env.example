# CipherScan Data Bot — Environment Configuration
# Copy to /opt/cipherscan/.env.bot on production

# Database (same as the API)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zcash_explorer_mainnet
DB_USER=zcash_user
DB_PASSWORD=

# X (Twitter) API — OAuth2 User Context
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Bot behavior
BOT_DRY_RUN=1
BOT_DIGEST_HOUR=8

# Weekly animated replay (Sundays from 21:00 UTC). Needs ffmpeg with libx264 on the host.
# Optional: read history from another API base (default https://api.zecblock.com)
# BOT_API_BASE=
