# Dedicated worker environment only. Never copy the primary API/indexer .env.
ASK_ANALYTICS_ENABLED=false
ASK_ANALYTICS_DATABASE_URL=
ASK_ANALYTICS_REDIS_URL=
ASK_ANALYTICS_SERVICE_KEY=
ASK_ANALYTICS_DAILY_QUERY_LIMIT=200
ASK_ANALYTICS_PORT=3015

# Opt in only after catalogue-destination-v1.sql and reviewed source copy setup.
ASK_RESEARCH_EXTENDED=false
# Fixed anonymous execution and query-shape counts only, TTL 30 days. No questions/SQL/IDs.
ASK_RESEARCH_METRICS_ENABLED=false
