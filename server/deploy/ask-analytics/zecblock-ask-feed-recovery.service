[Unit]
Description=Guarded recovery of the private analytics replication feed
After=postgresql@16-main.service zecblock-ask-source-transport.service
[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/python3 /opt/zecblock-ask-recovery/feed-recovery.py
StateDirectory=zecblock-ask-recovery
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=40
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=192M
CPUQuota=25%
TasksMax=16
ReadWritePaths=/var/lib/zecblock-ask-recovery
