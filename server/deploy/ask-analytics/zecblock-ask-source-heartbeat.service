[Unit]
Description=Fixed public analytics source freshness signal
After=postgresql.service
[Service]
Type=oneshot
User=postgres
ExecStart=/usr/bin/psql -X -w -q -v ON_ERROR_STOP=1 -d zcash_explorer_mainnet -f /opt/zecblock-ask-feed/source-heartbeat.sql
TimeoutStartSec=8
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
