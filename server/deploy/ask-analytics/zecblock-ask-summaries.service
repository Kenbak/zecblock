[Unit]
Description=Refresh completed-day public research summaries
After=postgresql.service zecblock-ask-admission.service
[Service]
Type=oneshot
User=postgres
WorkingDirectory=/opt/zecblock-analytics
ExecStart=/opt/zecblock-analytics/runtime/bin/node /opt/zecblock-analytics/server/api/scripts/refresh-ask-summaries.js
TimeoutStartSec=210
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
TasksMax=32
