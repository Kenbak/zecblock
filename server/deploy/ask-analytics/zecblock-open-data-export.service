[Unit]
Description=Export ZecBlock open data as Parquet
After=postgresql.service
OnSuccess=zecblock-open-data-publish.service
[Service]
Type=oneshot
User=ask_query
Group=ask_db_socket
UMask=0022
WorkingDirectory=/opt/zecblock-open-data/server/open-data
Environment="OPEN_DATA_DATABASE_URL=host=/run/ask-public-db dbname=ask_analytics user=ask_public_reader"
ExecStart=/opt/zecblock-open-data/venv/bin/python open_data.py export --out /srv/open-data
TimeoutStartSec=6h
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/open-data
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=16G
CPUQuota=200%
TasksMax=32
