[Unit]
Description=Bounded NEAR Explorer history backfill (new tables only)
After=network-online.target postgresql.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/cipherscan-crosschain/current/server/deploy/crosschain-backfill-batch.sh
TimeoutStartSec=90
KillMode=control-group
Nice=10
IOSchedulingClass=idle
UMask=0077
# Hardening that needs no per-job path list: no privilege gain, private /tmp,
# read-only /usr, /boot and /etc, and no kernel/cgroup changes. Still runs as
# root; moving to a dedicated User= needs per-host ownership changes first.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
