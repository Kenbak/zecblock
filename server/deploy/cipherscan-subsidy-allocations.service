[Unit]
Description=Maintain canonical historical subsidy allocations for actual miner receipts
After=network-online.target postgresql.service
ConditionPathExists=/etc/cipherscan/subsidy-allocations.env
[Service]
Type=oneshot
WorkingDirectory=/root/cipherscan
Environment=NODE_PATH=/root/cipherscan/server/api/node_modules
EnvironmentFile=/etc/cipherscan/subsidy-allocations.env
StateDirectory=cipherscan-subsidy-allocations
StateDirectoryMode=0700
ExecStart=/usr/bin/node server/jobs/maintain-subsidy-allocations.js
TimeoutStartSec=60
TimeoutStopSec=5
Nice=15
CPUWeight=10
IOWeight=10
MemoryMax=256M
UMask=0077
# Hardening that needs no per-job path list: no privilege gain, private /tmp,
# read-only /usr, /boot and /etc, and no kernel/cgroup changes. Still runs as
# root; moving to a dedicated User= needs per-host ownership changes first.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
