[Unit]
Description=Archive completed canonical daily chain supply
After=network-online.target postgresql.service
[Service]
Type=oneshot
WorkingDirectory=/root/cipherscan
Environment=NODE_PATH=/root/cipherscan/server/api/node_modules
ExecStart=/usr/bin/node server/jobs/archive-chain-supply.js
TimeoutStartSec=600
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
MemoryMax=512M
UMask=0077
# Hardening that needs no per-job path list: no privilege gain, private /tmp,
# read-only /usr, /boot and /etc, and no kernel/cgroup changes. Still runs as
# root; moving to a dedicated User= needs per-host ownership changes first.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
