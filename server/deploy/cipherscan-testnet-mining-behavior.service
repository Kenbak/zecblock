[Unit]
Description=Refresh 30 completed UTC dates of attributed testnet miner payouts
After=network-online.target postgresql.service
ConditionPathExists=/etc/cipherscan/subsidy-allocations.env
[Service]
Type=oneshot
WorkingDirectory=/root/cipherscan
Environment=NODE_PATH=/root/cipherscan/server/api/node_modules
EnvironmentFile=/etc/cipherscan/subsidy-allocations.env
Environment=NETWORK=testnet
ExecStart=/usr/bin/node server/jobs/snapshot-mining-behavior.js --days=30
TimeoutStartSec=600
TimeoutStopSec=5
Nice=15
CPUWeight=10
IOWeight=10
MemoryMax=256M
UMask=0077
# Hardening that needs no per-job path list: no privilege gain, private /tmp,
# read-only /usr, /boot and /etc, and no kernel/cgroup changes. Still runs as
# root; moving to a dedicated User= needs per-host ownership changes first.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
