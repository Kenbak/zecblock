+/// Hash literals use display order; P2P hashes are serialized little endian.
+fn display_hash(hash: &str) -> Hash {
+    let mut bytes: [u8; 32] = hex::decode(hash)
+        .expect("valid pinned hash")
+        .try_into()
+        .unwrap();
+    bytes.reverse();
+    Hash::new(bytes)
+}
+
+fn checkpoint_parent_hash() -> Hash {
+    display_hash("00000000004cdd2c00f60266d185a2e0992ae8ab0a23d1896982bcf35bb720d6")
+}
