+        let count = *VarInt::decode(bytes)?;
+        let encoded_length = original_length - bytes.len();
+        let canonical_length = match count {
+            0..=252 => 1,
+            253..=65_535 => 3,
+            _ => 5,
+        };
+        if count > maximum || encoded_length != canonical_length {
+            return Err(Error::new(
