+#[cfg(test)]
+mod gossip_tests {
+    use super::*;
+
+    fn qualified() -> KnownNode {
+        let mut node = KnownNode {
+            version_received: true,
+            verack_received: true,
+            ..Default::default()
+        };
+        assert!(node.record_verification());
+        assert!(node.record_chain_verification());
+        node
+    }
+
+    #[test]
+    fn gossip_requires_fresh_proof_and_does_not_qualify_target() {
+        let network = KnownNetwork::default();
+        let source = "192.0.2.1:8233".parse().unwrap();
+        let target = "192.0.2.2:8233".parse().unwrap();
+        assert!(!network.record_qualified_addrs(source, &[target]));
+        network.nodes.write().insert(source, KnownNode::default());
+        assert!(!network.record_qualified_addrs(source, &[target]));
+        assert_eq!(network.num_nodes(), 1);
+        network.nodes.write().insert(source, qualified());
+        assert!(network.record_qualified_addrs(source, &[target]));
+        assert!(!network.nodes.read()[&target].recently_verified());
+        assert!(network.nodes.read()[&target].gossip.is_empty());
+        network
+            .nodes
+            .write()
+            .get_mut(&source)
+            .unwrap()
+            .last_chain_verified = Some(Instant::now() - Duration::from_secs(VERIFIED_WINDOW_SECS));
+        assert!(!network.record_qualified_addrs(source, &[target]));
+    }
+
+    #[test]
+    fn gossip_is_directed_repeated_receipts_refresh_and_sessions_clear() {
+        let network = KnownNetwork::default();
+        let source = "192.0.2.1:8233".parse().unwrap();
+        let target = "192.0.2.2:8233".parse().unwrap();
+        network
+            .nodes
+            .write()
+            .extend([(source, qualified()), (target, qualified())]);
+        network.record_qualified_addrs(source, &[source, target]);
+        assert_eq!(network.nodes.read()[&source].gossip.len(), 1);
+        assert!(network.nodes.read()[&target].gossip.is_empty());
+        let old = Instant::now() - Duration::from_secs(30);
+        network
+            .nodes
+            .write()
+            .get_mut(&source)
+            .unwrap()
+            .gossip
+            .get_mut(&target)
+            .unwrap()
+            .observed_at = old;
+        network.record_qualified_addrs(source, &[target]);
+        assert!(network.nodes.read()[&source].gossip[&target].observed_at > old);
+        network.record_qualified_addrs(target, &[source]);
+        assert!(network.nodes.read()[&target].gossip.contains_key(&source));
+        network
+            .nodes
+            .write()
+            .get_mut(&source)
+            .unwrap()
+            .begin_attempt(Instant::now());
+        assert!(network.nodes.read()[&source].gossip.is_empty());
+        assert!(!network.record_qualified_addrs(source, &[target]));
+        network
+            .nodes
+            .write()
+            .get_mut(&target)
+            .unwrap()
+            .invalidate_chain_proof();
+        assert!(network.nodes.read()[&target].gossip.is_empty());
+    }
+
+    #[test]
+    fn gossip_storage_is_bounded_and_expired_receipts_are_pruned() {
+        let network = KnownNetwork::default();
+        let source = "192.0.2.1:8233".parse().unwrap();
+        network.nodes.write().insert(source, qualified());
+        let targets = (1..=MAX_GOSSIP_TARGETS_PER_SOURCE + 1)
+            .map(|port| SocketAddr::from(([192, 0, 2, 2], port as u16)))
+            .collect::<Vec<_>>();
+        network.record_qualified_addrs(source, &targets);
+        assert_eq!(
+            network.nodes.read()[&source].gossip.len(),
+            MAX_GOSSIP_TARGETS_PER_SOURCE
+        );
+        network.record_qualified_addrs(source, &targets[MAX_GOSSIP_TARGETS_PER_SOURCE..]);
+        assert_eq!(
+            network.nodes.read()[&source].gossip.len(),
+            MAX_GOSSIP_TARGETS_PER_SOURCE
+        );
+        for observation in network
+            .nodes
+            .write()
+            .get_mut(&source)
+            .unwrap()
+            .gossip
+            .values_mut()
+        {
+            observation.observed_at = Instant::now() - Duration::from_secs(LAST_SEEN_CUTOFF);
+        }
+        network.remove_old_connections();
+        assert!(network.nodes.read()[&source].gossip.is_empty());
     }
