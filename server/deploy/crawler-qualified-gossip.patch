 pub const ZCASH_P2P_DEFAULT_MAINNET_PORT: u16 = 8233;
+pub const GOSSIP_PROVENANCE: &str = "zcash-mainnet-qualified-addr-v1";
+pub const MAX_GOSSIP_EDGES: usize = 40_000;
+
+/// Recent address advertisement from a same-session chain-qualified source.
+/// Direction means "source advertised target", never a confirmed remote link.
+#[derive(Debug, Clone, Serialize)]
+pub struct GossipEdge {
+    pub source: String,
+    pub target: String,
+    pub observed_at_ms: u64,
+}
+
+/// Bound the wire payload deterministically, preferring actual recent receipts.
+fn bound_gossip_edges(edges: &mut Vec<GossipEdge>) -> bool {
+    edges.sort_by(|a, b| {
+        b.observed_at_ms
+            .cmp(&a.observed_at_ms)
+            .then_with(|| (&a.source, &a.target).cmp(&(&b.source, &b.target)))
+    });
+    let truncated = edges.len() > MAX_GOSSIP_EDGES;
+    edges.truncate(MAX_GOSSIP_EDGES);
+    truncated
+}
 
 /// Per-node info exposed in the extended summary for the cruncher.
 #[derive(Debug, Clone, Serialize)]
