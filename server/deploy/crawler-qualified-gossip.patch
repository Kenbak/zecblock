+    /// Atomically qualify the advertiser and record directed, bounded gossip.
+    /// Targets enter discovery as candidates, never as verified active nodes.
+    pub fn record_qualified_addrs(
+        &self,
+        source: SocketAddr,
+        listening_addrs: &[SocketAddr],
+    ) -> bool {
+        let mut nodes = self.nodes.write();
         {
-            let connections = &mut self.connections.write();
-            for addr in listening_addrs {
-                connections.insert(KnownConnection::new(source, *addr));
+            let Some(node) = nodes.get_mut(&source) else {
+                return false;
+            };
+            if !node.recently_verified() {
+                return false;
+            }
+            node.gossip.retain(|_, observation| {
+                observation.observed_at.elapsed().as_secs() < LAST_SEEN_CUTOFF
+            });
+            let observation = GossipObservation {
+                observed_at: Instant::now(),
+                observed_at_ms: unix_ms(),
