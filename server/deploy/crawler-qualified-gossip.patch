+#[cfg(test)]
+mod gossip_summary_tests {
+    use super::*;
+    use crate::network::{GossipObservation, VERIFIED_WINDOW_SECS};
+    use pea2pea::Pea2Pea;
+    use std::time::{Duration, Instant};
+
+    fn qualified() -> KnownNode {
+        let mut node = KnownNode {
+            version_received: true,
+            verack_received: true,
+            ..Default::default()
+        };
+        assert!(node.record_verification());
+        assert!(node.record_chain_verification());
+        node
+    }
+
+    #[tokio::test]
+    async fn summary_preserves_direction_proof_clocks_and_unverified_candidates() {
+        let crawler = Crawler::new().await;
+        let source = "192.0.2.1:8233".parse().unwrap();
+        let target = "192.0.2.2:8233".parse().unwrap();
+        crawler
+            .known_network
+            .nodes
+            .write()
+            .insert(source, qualified());
+        crawler
+            .known_network
+            .record_qualified_addrs(source, &[target]);
+        let mut metrics = NetworkMetrics::default();
+        let first = metrics.request_summary(&crawler);
+        assert_eq!(first.gossip_provenance, GOSSIP_PROVENANCE);
+        assert_eq!(first.node_info.len(), 1);
+        assert_eq!(first.node_info[0].addr, source.to_string());
+        assert_eq!(first.gossip_edges.len(), 1);
+        let edge = &first.gossip_edges[0];
+        assert_eq!(edge.source, source.to_string());
+        assert_eq!(edge.target, target.to_string());
+        let wire = jsonrpsee::core::to_json_value(&first).unwrap();
+        assert_eq!(wire["gossip_provenance"], GOSSIP_PROVENANCE);
+        assert_eq!(wire["gossip_truncated"], false);
+        assert_eq!(wire["gossip_edges"][0]["source"], source.to_string());
+        assert_eq!(wire["gossip_edges"][0]["target"], target.to_string());
+        assert_eq!(
+            wire["gossip_edges"][0]["observed_at_ms"],
+            edge.observed_at_ms
+        );
+        assert_eq!(wire["gossip_edges"][0].as_object().unwrap().len(), 3);
+        assert!(first.node_info[0].last_verified_at_ms <= first.node_info[0].chain_verified_at_ms);
+        assert!(first.node_info[0].chain_verified_at_ms.unwrap() <= edge.observed_at_ms);
+        assert!(edge.observed_at_ms <= first.generated_at_ms);
+        assert!(!crawler.known_network.nodes.read()[&target].recently_verified());
+        let second = metrics.request_summary(&crawler);
+        assert_eq!(
+            second.gossip_edges[0].observed_at_ms, edge.observed_at_ms,
+            "publishing a summary is not another advertisement"
+        );
+        crawler
+            .known_network
+            .nodes
+            .write()
+            .insert(target, qualified());
+        crawler
+            .known_network
+            .record_qualified_addrs(target, &[source]);
+        let reciprocal = metrics.request_summary(&crawler);
+        assert_eq!(
+            reciprocal.gossip_edges.len(),
+            2,
+            "reciprocal advertisements stay distinct"
+        );
+        crawler
+            .known_network
+            .nodes
+            .write()
+            .get_mut(&source)
+            .unwrap()
+            .begin_attempt(Instant::now());
+        let reconnected = metrics.request_summary(&crawler);
+        assert_eq!(reconnected.gossip_edges.len(), 1);
+        assert_eq!(reconnected.gossip_edges[0].source, target.to_string());
+        assert_eq!(
+            first.gossip_edges.len(),
+            1,
+            "published snapshots own their captured evidence"
+        );
+        crawler.node().shut_down().await;
+    }
+
+    #[tokio::test]
+    async fn summary_rejects_expired_receipts_expired_proofs_and_inconsistent_wall_clocks() {
+        let crawler = Crawler::new().await;
+        let source = "192.0.2.1:8233".parse().unwrap();
+        let target = "192.0.2.2:8233".parse().unwrap();
+        let mut metrics = NetworkMetrics::default();
+        for invalid in [
+            "receipt-expired",
+            "proof-expired",
+            "before-proof",
+            "future-receipt",
+            "bad-proof-order",
+        ] {
+            let mut node = qualified();
+            let proof_at = node.chain_verified_at_ms.unwrap();
+            let mut observation = GossipObservation {
+                observed_at: Instant::now(),
+                observed_at_ms: proof_at,
+            };
+            match invalid {
+                "receipt-expired" => {
+                    observation.observed_at = Instant::now() - Duration::from_secs(LAST_SEEN_CUTOFF)
+                }
+                "proof-expired" => {
+                    node.last_chain_verified =
+                        Some(Instant::now() - Duration::from_secs(VERIFIED_WINDOW_SECS))
+                }
+                "before-proof" => observation.observed_at_ms = proof_at - 1,
+                "future-receipt" => observation.observed_at_ms = unix_ms() + 60_000,
+                "bad-proof-order" => node.last_verified_at_ms = Some(proof_at + 1),
+                _ => unreachable!(),
+            }
+            node.gossip.insert(target, observation);
+            crawler.known_network.nodes.write().insert(source, node);
+            assert!(
+                metrics.request_summary(&crawler).gossip_edges.is_empty(),
+                "{invalid}"
+            );
+        }
+        crawler.node().shut_down().await;
+    }
+
+    #[tokio::test]
+    async fn empty_summary_advertises_capability_without_fabricating_edges() {
+        let crawler = Crawler::new().await;
+        let summary = NetworkMetrics::default().request_summary(&crawler);
+        assert_eq!(summary.gossip_provenance, GOSSIP_PROVENANCE);
+        assert!(summary.gossip_edges.is_empty());
+        assert!(!summary.gossip_truncated);
+        assert!(summary.node_info.is_empty());
+        assert!(summary.generated_at_ms > 0);
+        crawler.node().shut_down().await;
+    }
+
+    #[test]
+    fn global_export_cap_keeps_newest_receipts_and_stable_endpoint_ties() {
+        // Forty-one sources, each within its independent 1,000-target bound.
+        let mut edges = (0..=MAX_GOSSIP_EDGES)
+            .map(|i| GossipEdge {
+                source: format!("192.0.2.{}:8233", i / 1_000 + 1),
+                target: format!("198.51.100.1:{}", i % 1_000 + 1),
+                observed_at_ms: if i == 0 {
+                    999
+                } else if i == MAX_GOSSIP_EDGES {
+                    1_001
+                } else {
+                    1_000
+                },
+            })
+            .collect();
+        assert!(bound_gossip_edges(&mut edges));
+        assert_eq!(edges.len(), MAX_GOSSIP_EDGES);
+        assert_eq!(edges[0].observed_at_ms, 1_001);
+        assert!(!edges.iter().any(|edge| edge.observed_at_ms == 999));
+        for pair in edges[1..].windows(2) {
+            assert!((&pair[0].source, &pair[0].target) <= (&pair[1].source, &pair[1].target));
+        }
+        let wire = jsonrpsee::core::to_json_value(&edges).unwrap();
+        assert_eq!(wire[0]["observed_at_ms"], 1_001);
+        assert!(
+            !bound_gossip_edges(&mut edges),
+            "an already bounded payload is not truncated again"
+        );
+        assert!(!bound_gossip_edges(&mut Vec::new()));
+    }
+}
